# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Arquivos de configuracao locais (contem dados sensiveis / especificos)
*.tfvars
!*.tfvars.example
backend.hcl
!backend.hcl.example

# Planos
*.tfplan
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# .terraform.lock.hcl DEVE ser commitado (versiona os hashes dos providers)
